{
  "manifest_version": 3,
  "name": "Telegram · Archivo local",
  "version": "3.0.0",
  "description": "Guarda vídeos y crea copias por temas con carpetas ordenadas, mensajes, progreso y actualización incremental.",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "Mostrar vídeos de Telegram",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.telegram.org/*"
      ],
      "js": [
        "core.js",
        "bulk-engine.js",
        "bulk-progress.js",
        "bulk-page.js",
        "page.js",
        "manual-page.js",
        "photo-page.js",
        "backup-core.js",
        "backup-page.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://web.telegram.org/*"
      ],
      "js": [
        "panel-styles.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ]
}
